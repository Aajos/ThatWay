  "nodes": [
    {
      "id": "n001",
      "type": "text",
      "text": "## S0 Prototype\nSep 2026\nDONE\nScreens, real location, compass, OSRM",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "4"
    },
    {
      "id": "n002",
      "type": "text",
      "text": "## S1 Core build\nto 15 Nov 2026\nNOW\nv1.0 features, working sign-up and friends, polyline on 3 routes",
      "x": 360,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "2"
    },
    {
      "id": "n003",
      "type": "text",
      "text": "## S2 Hardening\nto 14 Nov 2026\nPower and memory baselines, accessibility pass",
      "x": 720,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "2"
    },
    {
      "id": "n004",
      "type": "text",
      "text": "## S3 Internal TestFlight\n1 Dec 2026\nYou plus 2 friends: a full drive and walk, no crash",
      "x": 1080,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "3"
    },
    {
      "id": "n005",
      "type": "text",
      "text": "## S4 External beta\nto 10 Jan 2027\n20 to 50 testers, App Review dry run",
      "x": 1440,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "3"
    },
    {
      "id": "n006",
      "type": "text",
      "text": "## S5 Launch v1.0 (MVP)\n15 Jan 2027\nFree: core navigation and basic friends",
      "x": 1800,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "1"
    },
    {
      "id": "n007",
      "type": "text",
      "text": "## S6 v1.1 paid\nto 30 Apr 2027\nProximity (UWB), tracking, purchase and restore",
      "x": 2160,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "5"
    },
    {
      "id": "n008",
      "type": "text",
      "text": "## S7 v1.2 looks\nto 30 Jun 2027\nSkins and themes as data",
      "x": 2520,
      "y": 0,
      "width": 320,
      "height": 190,
      "color": "5"
    },
